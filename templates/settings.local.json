{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Bash(*)",
      "WebFetch(*)",
      "Read(./.env.example)",
      "Edit(./.env.example)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git commit:*)"
    ]
  }
}
